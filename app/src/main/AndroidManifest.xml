<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 이 앱이 선언하는 유일한 권한. adb pm grant 로만 부여할 수 있다. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Adbtoggle">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DevOptionsTileService"
            android:exported="true"
            android:icon="@drawable/ic_dev_off"
            android:label="@string/label_dev"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".UsbTileService"
            android:exported="true"
            android:icon="@drawable/ic_usb_off"
            android:label="@string/label_usb"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".WirelessTileService"
            android:exported="true"
            android:icon="@drawable/ic_wifi_off"
            android:label="@string/label_wireless"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".DevOptionsWidgetProvider"
            android:exported="true"
            android:icon="@drawable/widget_preview_dev"
            android:label="@string/widget_label_dev">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dev_info" />
        </receiver>

        <receiver
            android:name=".UsbWidgetProvider"
            android:exported="true"
            android:icon="@drawable/widget_preview_usb"
            android:label="@string/widget_label_usb">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_usb_info" />
        </receiver>

        <receiver
            android:name=".WirelessWidgetProvider"
            android:exported="true"
            android:icon="@drawable/widget_preview_wireless"
            android:label="@string/widget_label_wireless">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wireless_info" />
        </receiver>

        <receiver
            android:name=".CombinedWidgetProvider"
            android:exported="true"
            android:icon="@drawable/widget_icon_combined"
            android:label="@string/widget_label_combined">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined_info" />
        </receiver>

        <!-- 위젯 탭 전용. 외부 앱이 토글을 유발하지 못하도록 비공개. -->
        <receiver
            android:name=".WidgetToggleReceiver"
            android:exported="false" />
    </application>

</manifest>
